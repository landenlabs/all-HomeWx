<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <!-- PHONE landscape (smallest width < 600dp): left/right halves. Tablets use
         layout-sw600dp-land / layout-sw720dp-land instead. The left half's weather + sensors sit in
         one vertical scroll (weatherScroll) - see the portrait phone layout's comment. System-bar
         insets are applied as padding on this root in MainActivity. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/middleGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <View
        android:id="@+id/topPanelBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_panel_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/middleGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- date/time title row, with the settings gear floating on its right - stays put above
         the scrolling weather/sensor area -->
    <TextView
        android:id="@+id/weatherDateTimeText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="19sp"
        app:layout_constraintEnd_toStartOf="@id/middleGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="16 Aug, Sun 10:54 PM" />

    <TextView
        android:id="@+id/currentLuxText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/weatherDateTimeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/weatherDateTimeText"
        tools:text="8 lux" />

    <!-- Low-battery percent, right of the lux readout; only visible below 50% (set from code). -->
    <TextView
        android:id="@+id/batteryLevelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_battery"
        android:drawablePadding="2dp"
        android:gravity="center_vertical"
        android:textColor="@color/battery_low"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/currentLuxText"
        app:layout_constraintStart_toEndOf="@id/currentLuxText"
        app:layout_constraintTop_toTopOf="@id/currentLuxText"
        tools:text="42%"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_settings_gear"
        android:contentDescription="@string/settings_title"
        android:padding="2dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintBottom_toBottomOf="@id/weatherDateTimeText"
        app:layout_constraintEnd_toStartOf="@id/middleGuideline"
        app:layout_constraintTop_toTopOf="@id/weatherDateTimeText"
        app:tint="@color/text_secondary" />

    <!-- Weather block + sensor list in one vertical scroll. weatherBlock's minHeight is set in
         MainActivity to (visible scroll height - sensor header), so with the sensor rows
         collapsed everything fits exactly with no scrolling; expanding them adds content below
         and MainActivity scrolls down, pushing the weather image up. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/weatherScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/middleGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/weatherDateTimeText">

        <LinearLayout
            android:id="@+id/weatherScrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/weatherBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Fills the whole block and bleeds full-width behind the icon/grid content,
                     which stays inset via their own margins. -->
                <ImageView
                    android:id="@+id/weatherBackgroundImage"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/wx_bg_clear" />

                <!-- Darken amount is set from code (foreground.alpha), driven by the settings slider. -->
                <View
                    android:id="@+id/weatherBackgroundScrim"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="#000000"
                    app:layout_constraintBottom_toBottomOf="@id/weatherBackgroundImage"
                    app:layout_constraintEnd_toEndOf="@id/weatherBackgroundImage"
                    app:layout_constraintStart_toStartOf="@id/weatherBackgroundImage"
                    app:layout_constraintTop_toTopOf="@id/weatherBackgroundImage" />

                <!-- icon + big temperature, centered as a packed chain within the block -->
                <ImageView
                    android:id="@+id/weatherIcon"
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/wx_sun_44d"
                    app:layout_constraintBottom_toTopOf="@id/currentTempText"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/currentTempText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weather_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="35sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/tempTrendText"
                    app:layout_constraintEnd_toEndOf="@id/weatherIcon"
                    app:layout_constraintStart_toStartOf="@id/weatherIcon"
                    app:layout_constraintTop_toBottomOf="@id/weatherIcon" />

                <TextView
                    android:id="@+id/tempTrendText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="26sp"
                    app:layout_constraintBottom_toTopOf="@id/tempTrend4hText"
                    app:layout_constraintEnd_toEndOf="@id/weatherIcon"
                    app:layout_constraintStart_toStartOf="@id/weatherIcon"
                    app:layout_constraintTop_toBottomOf="@id/currentTempText"
                    tools:text="+2°F/+1hr" />

                <TextView
                    android:id="@+id/tempTrend4hText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/weatherIcon"
                    app:layout_constraintStart_toStartOf="@id/weatherIcon"
                    app:layout_constraintTop_toBottomOf="@id/tempTrendText"
                    tools:text="+3°F/+4hr" />

                <!-- condition/humidity/wind/precip/pressure table: label,value per row (2 columns -
                     a phone is about as narrow as half a tablet, same as layout-land). Columns
                     size to content and center as a whole within the block. -->
                <GridLayout
                    android:id="@+id/weatherDetailsGrid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="4dp"
                    android:columnCount="2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/weatherIcon"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView style="@style/wx_label" android:text="@string/wx_lbl_condition" />
                    <TextView android:id="@+id/conditionValueText" style="@style/wx_value" />
                    <TextView style="@style/wx_label" android:text="@string/wx_lbl_humidity" />
                    <TextView android:id="@+id/humidityValueText" style="@style/wx_value" />

                    <TextView style="@style/wx_label" android:text="@string/wx_lbl_temp_high" />
                    <TextView android:id="@+id/tempHighValueText" style="@style/wx_value" />
                    <TextView style="@style/wx_label" android:text="@string/wx_lbl_temp_low" />
                    <TextView android:id="@+id/tempLowValueText" style="@style/wx_value" />

                    <TextView style="@style/wx_label" android:text="@string/wx_lbl_wind_low" />
                    <TextView android:id="@+id/windLowValueText" style="@style/wx_value" />
                    <TextView style="@style/wx_label" android:text="@string/wx_lbl_wind_high" />
                    <TextView android:id="@+id/windHighValueText" style="@style/wx_value" />

                    <TextView android:id="@+id/windSpeedLabelText" style="@style/wx_label" android:text="@string/wx_lbl_wind_speed" />
                    <TextView android:id="@+id/windSpeedValueText" style="@style/wx_value" />
                    <TextView android:id="@+id/windDirectionLabelText" style="@style/wx_label" android:text="@string/wx_lbl_wind_direction" />
                    <TextView android:id="@+id/windDirectionValueText" style="@style/wx_value" />

                    <TextView style="@style/wx_label" android:text="@string/wx_lbl_precipitation" />
                    <TextView android:id="@+id/precipitationValueText" style="@style/wx_value" />
                    <TextView style="@style/wx_label" android:text="@string/wx_lbl_pressure" />
                    <TextView android:id="@+id/pressureValueText" style="@style/wx_value" />

        <!-- Single-column layout: min/max share one row ("LstYr  56°F/72°F") - see
             MainActivity.bindLastYearRow(). -->
        <TextView android:id="@+id/lyMinLabelText" style="@style/wx_label" android:text="@string/wx_lbl_ly" />
        <TextView android:id="@+id/lyMinValueText" style="@style/wx_value" />
                </GridLayout>

                <!-- Attribution badge for the active weather source (Open-Meteo/WxData). -->
                <ImageView
                    android:id="@+id/weatherSourceBadge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_margin="8dp"
                    android:alpha="0.85"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="@id/weatherBackgroundImage"
                    app:layout_constraintEnd_toEndOf="@id/weatherBackgroundImage"
                    tools:src="@drawable/wx_source_wxdata" />

                <!-- App launcher icon, mirroring the source badge in the bottom-start corner. -->
                <ImageView
                    android:id="@+id/appIconBadge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_margin="8dp"
                    android:alpha="0.85"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher"
                    app:layout_constraintBottom_toBottomOf="@id/weatherBackgroundImage"
                    app:layout_constraintStart_toStartOf="@id/weatherBackgroundImage" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- SENSORS SECTION -->
            <View
                android:id="@+id/topDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/sensorsTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                android:letterSpacing="0.08"
                android:text="SENSORS"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/sensorErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:textColor="#E36464"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Sensor error: timeout" />

            <!-- Scrolls with the weather block (nestedScrollingEnabled off), never by itself. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sensorRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- RIGHT HALF: news tabs / sensor strip chart -->
    <View
        android:id="@+id/bottomPanelBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_panel_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/middleGuideline"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/centerDivider"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/middleGuideline"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/infoPanelTabBar"
        layout="@layout/info_panel_tabbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/centerDivider"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/infoPanelContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/centerDivider"
        app:layout_constraintTop_toBottomOf="@id/infoPanelTabBar" />

</androidx.constraintlayout.widget.ConstraintLayout>
