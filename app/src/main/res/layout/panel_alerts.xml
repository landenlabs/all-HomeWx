<?xml version="1.0" encoding="utf-8"?>
<!-- Weather-alert details, shown over the weather panel when its flashing alert icon is tapped.
     <include>d into every activity_main.xml variant, sized there to the weather panel's bounds.
     Clickable so taps/swipes don't fall through to the weather panel's day-swipe handler. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alert_panel_bg"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/alertBackButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/alert_back_description"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="←"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/alertPanelTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/alertPanelSource"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/alertBackButton"
        app:layout_constraintTop_toTopOf="@id/alertBackButton"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="2 weather alerts" />

    <TextView
        android:id="@+id/alertPanelSource"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/alertBackButton"
        app:layout_constraintEnd_toEndOf="@id/alertPanelTitle"
        app:layout_constraintStart_toStartOf="@id/alertPanelTitle"
        app:layout_constraintTop_toBottomOf="@id/alertPanelTitle"
        tools:text="Source: NWS · updated 10:42 AM" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/alertRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alertBackButton"
        tools:listitem="@layout/item_weather_alert" />

</androidx.constraintlayout.widget.ConstraintLayout>
