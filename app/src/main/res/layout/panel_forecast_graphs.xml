<?xml version="1.0" encoding="utf-8"?>
<!-- Up to 4 charts (temperature, wind, precipitation, pressure - pressure only shown for the
     Past range) sharing equal height. Each chart is wrapped in a FrameLayout with a large
     watermark label behind it (drawn first, so the chart - transparent background - shows it
     through its own empty space; biased toward the top third via its ConstraintLayout wrapper
     rather than dead center, which is where the y-axis auto-scaling and the "no history yet"
     empty-state message both already sit) and an "empty" TextView overlay, followed by a
     legend-style row below the chart: the max value of the plotted series centered, and the
     chart's title at the right edge (not MPAndroidChart's built-in description, which draws
     inside the chart's own bottom-right corner and overlapped the hourly view's day-of-week axis
     labels there). This mirrors SensorHistoryChartView's watermark + legend-row styling. Each
     outer *Section LinearLayout and its inner *ChartFrame can be collapsed to
     wrap_content/weight=0 by ForecastGraphsPanel when that metric has no data, so the other
     sections' weight=1 absorbs the freed space. -->
<!-- Wrapped in a fillViewport ScrollView: when every section fits at its graph_min_height (always
     on tablets, where that minimum is 0) the content is stretched to the viewport and the sections
     share it by weight exactly as before; on a short phone panel the sections stop at their
     minimum and the stack scrolls vertically instead. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/forecastTempSection"
        style="@style/graph_scroll_section">

        <FrameLayout
            android:id="@+id/forecastTempChartFrame"
            style="@style/graph_chart_frame">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Biased toward the top third rather than dead center - center is where the
                     y-axis auto-scaling and the "no history yet" empty-state message both
                     already sit. -->
                <TextView
                    android:id="@+id/forecastTempWatermarkText"
                    style="@style/graph_watermark_text" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/forecastTempChartView"
                style="@style/graph_line_chart" />

            <TextView
                android:id="@+id/forecastTempEmptyText"
                style="@style/graph_empty_text" />

        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/forecastTempMaxValueText"
                style="@style/graph_legend_value_text" />

            <TextView
                android:id="@+id/forecastTempTitleText"
                style="@style/graph_legend_title_text"
                app:layout_constraintStart_toEndOf="@id/forecastTempMaxValueText" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/forecastWindSection"
        style="@style/graph_scroll_section">

        <FrameLayout
            android:id="@+id/forecastWindChartFrame"
            style="@style/graph_chart_frame">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/forecastWindWatermarkText"
                    style="@style/graph_watermark_text" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/forecastWindChartView"
                style="@style/graph_line_chart" />

            <TextView
                android:id="@+id/forecastWindEmptyText"
                style="@style/graph_empty_text" />

        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/forecastWindMaxValueText"
                style="@style/graph_legend_value_text" />

            <TextView
                android:id="@+id/forecastWindTitleText"
                style="@style/graph_legend_title_text"
                app:layout_constraintStart_toEndOf="@id/forecastWindMaxValueText" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/forecastPrecipSection"
        style="@style/graph_scroll_section">

        <FrameLayout
            android:id="@+id/forecastPrecipChartFrame"
            style="@style/graph_chart_frame">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/forecastPrecipWatermarkText"
                    style="@style/graph_watermark_text" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/forecastPrecipChartView"
                style="@style/graph_line_chart" />

            <TextView
                android:id="@+id/forecastPrecipEmptyText"
                style="@style/graph_empty_text" />

        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/forecastPrecipMaxValueText"
                style="@style/graph_legend_value_text" />

            <TextView
                android:id="@+id/forecastPrecipTitleText"
                style="@style/graph_legend_title_text"
                app:layout_constraintStart_toEndOf="@id/forecastPrecipMaxValueText" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/forecastPressureSection"
        style="@style/graph_scroll_section"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/forecastPressureChartFrame"
            style="@style/graph_chart_frame">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/forecastPressureWatermarkText"
                    style="@style/graph_watermark_text" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/forecastPressureChartView"
                style="@style/graph_line_chart" />

            <TextView
                android:id="@+id/forecastPressureEmptyText"
                style="@style/graph_empty_text" />

        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/forecastPressureMaxValueText"
                style="@style/graph_legend_value_text" />

            <TextView
                android:id="@+id/forecastPressureTitleText"
                style="@style/graph_legend_title_text"
                app:layout_constraintStart_toEndOf="@id/forecastPressureMaxValueText" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</LinearLayout>

</ScrollView>
