<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_forecast_card"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/forecastCardDateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:textColor="@color/accent_cool"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Mon Aug 24" />

    <!-- Icon is match_parent height so it fills whatever height the value stack ends up at. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/forecastCardIcon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:src="@drawable/wx_sun_44d" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/forecastCardHighText"
                style="@style/forecast_card_value"
                tools:text="78°F" />

            <TextView
                android:id="@+id/forecastCardWindText"
                style="@style/forecast_card_value"
                tools:text="12 mph" />

            <TextView
                android:id="@+id/forecastCardPrecipText"
                style="@style/forecast_card_value"
                tools:text="20%" />

            <TextView
                android:id="@+id/forecastCardLowText"
                style="@style/forecast_card_value"
                tools:text="61°F" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
