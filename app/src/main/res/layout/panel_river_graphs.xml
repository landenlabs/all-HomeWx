<?xml version="1.0" encoding="utf-8"?>
<!-- One chart per currently-selected river gauge, added/removed at runtime in RiverGraphsPanel
     since the count varies with how many gauges are selected in Settings. -->
<!-- Same fillViewport scroll behavior as panel_sensor_graphs.xml: charts share the height when
     they all fit at graph_min_height (0 on tablets), else hold that minimum and scroll. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/riverGraphsChartContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</ScrollView>
