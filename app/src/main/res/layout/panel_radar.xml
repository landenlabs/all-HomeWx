<?xml version="1.0" encoding="utf-8"?>
<!-- OpenStreetMap view with the Iowa Environmental Mesonet NEXRAD composite reflectivity tile
     layer drawn on top - see RadarPanel. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/radarMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/radarPlayButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:background="@color/bg_panel_bottom"
        android:contentDescription="@string/radar_play_animation"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_play"
        app:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/radarUpdatedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:background="@color/bg_panel_bottom"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</FrameLayout>
