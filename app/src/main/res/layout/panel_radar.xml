<?xml version="1.0" encoding="utf-8"?>
<!-- OpenStreetMap view with one tile layer drawn on top, chosen by radarLayerGroup: the Iowa
     Environmental Mesonet NEXRAD composite reflectivity, or NASA GIBS GOES satellite clouds
     (GeoColor / infrared) - see RadarPanel. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/radarMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RadioGroup
        android:id="@+id/radarLayerGroup"
        style="@style/graph_period_radio_group"
        android:layout_width="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@color/bg_panel_bottom"
        android:paddingHorizontal="8dp"
        android:visibility="visible">

        <RadioButton
            android:id="@+id/radarLayerRadar"
            style="@style/graph_period_radio_button"
            android:layout_marginEnd="20dp"
            android:checked="true"
            android:text="@string/radar_layer_radar" />

        <RadioButton
            android:id="@+id/radarLayerClouds"
            style="@style/graph_period_radio_button"
            android:layout_marginEnd="20dp"
            android:text="@string/radar_layer_clouds" />

        <RadioButton
            android:id="@+id/radarLayerInfrared"
            style="@style/graph_period_radio_button"
            android:text="@string/radar_layer_infrared" />

    </RadioGroup>

    <ImageButton
        android:id="@+id/radarPlayButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:background="@color/bg_panel_bottom"
        android:contentDescription="@string/radar_play_animation"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_play"
        app:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/radarUpdatedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:background="@color/bg_panel_bottom"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/radarNoDataText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_margin="8dp"
        android:background="@color/red"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="@string/radar_load_failed"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone" />

</FrameLayout>
