<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical">

    <!-- header row -->
    <LinearLayout
        android:id="@+id/settingsHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:text="←"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- WEATHER -->
            <TextView
                style="@style/settings_section_header"
                android:layout_marginTop="8dp"
                android:text="@string/settings_section_weather" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/settings_label"
                        android:text="@string/settings_weather_source_label" />

                    <Spinner
                        android:id="@+id/weatherSourceSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/settings_label"
                        android:layout_width="wrap_content"
                        android:text="@string/settings_weather_interval_label" />

                    <EditText
                        android:id="@+id/weatherIntervalEditText"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:autofillHints=""
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        tools:text="30" />
                </LinearLayout>

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/settings_label"
                        android:layout_width="wrap_content"
                        android:text="@string/settings_forecast_days_label" />

                    <EditText
                        android:id="@+id/forecastDaysEditText"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:autofillHints=""
                        android:inputType="number"
                        android:maxLength="2"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        tools:text="7" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/settings_divider" />

            <!-- DISPLAY: the three slider controls, grouped together -->
            <TextView
                style="@style/settings_section_header"
                android:text="@string/settings_section_display" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/settings_label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/settings_screen_brightness_label" />

                <TextView
                    android:id="@+id/screenBrightnessValueText"
                    style="@style/settings_value_text"
                    android:layout_marginStart="8dp"
                    tools:text="100%" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/screenBrightnessSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="90" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/settings_label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/settings_light_threshold_label" />

                <TextView
                    android:id="@+id/lightThresholdValueText"
                    style="@style/settings_value_text"
                    android:layout_marginStart="8dp"
                    tools:text="8 lux" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/lightThresholdSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="95" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/settings_label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/settings_background_darken_label" />

                <TextView
                    android:id="@+id/backgroundDarkenValueText"
                    style="@style/settings_value_text"
                    android:layout_marginStart="8dp"
                    tools:text="50%" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/backgroundDarkenSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100" />

            <View style="@style/settings_divider" />

            <!-- DAILY HIGH / LOW -->
            <TextView
                style="@style/settings_section_header"
                android:text="@string/settings_section_daily_extremes" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/settings_label"
                        android:text="@string/settings_temp_override_switch" />

                    <Switch
                        android:id="@+id/tempOverrideSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/settings_label"
                        android:text="@string/settings_temp_override_sensor_label" />

                    <Spinner
                        android:id="@+id/tempOverrideSensorSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/settings_divider" />

            <!-- SENSORS -->
            <TextView
                style="@style/settings_section_header"
                android:text="@string/settings_section_sensors" />

            <LinearLayout
                android:id="@+id/sensorVisibilityContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <View style="@style/settings_divider" />

            <!-- ARTICLE VIEWER -->
            <TextView
                style="@style/settings_section_header"
                android:text="@string/settings_section_webview_logging" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/settings_label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/settings_webview_logging_switch" />

                <Switch
                    android:id="@+id/webviewLoggingSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/webviewLogPathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Log file: /data/user/0/com.dlang.homewx/files/webview_request_domains.log" />

            <Button
                android:id="@+id/undoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="32dp"
                android:text="@string/settings_undo" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
