<?xml version="1.0" encoding="utf-8"?>
<!-- Forecast panel: a 2nd tab bar (Hourly/Daily) plus a cards/graph presentation toggle,
     then either the day/hour cards grid or the line-graph view below. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel_bottom"
        android:orientation="horizontal">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/forecastRangeTabLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:tabIndicatorColor="@color/accent_cool"
            app:tabSelectedTextColor="@color/text_primary"
            app:tabTextColor="@color/text_secondary" />

        <ImageButton
            android:id="@+id/forecastViewToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/forecast_switch_to_graph_view"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_graph"
            app:tint="@color/text_secondary" />

    </LinearLayout>

    <!-- Hourly-only: which slice of the forecast hours the cards/strip charts below show.
         Hidden for Past/Daily, which have no notion of "today"/"2 days". Shared by both the
         cards and graph presentations - toggling doesn't reset which one is showing. -->
    <RadioGroup
        android:id="@+id/forecastHourlyPeriodGroup"
        style="@style/graph_period_radio_group">

        <RadioButton
            android:id="@+id/forecastHourlyPeriodAll"
            style="@style/graph_period_radio_button"
            android:layout_marginEnd="20dp"
            android:text="@string/forecast_hourly_period_all" />

        <RadioButton
            android:id="@+id/forecastHourlyPeriodToday"
            style="@style/graph_period_radio_button"
            android:layout_marginEnd="20dp"
            android:checked="true"
            android:text="@string/forecast_hourly_period_today" />

        <RadioButton
            android:id="@+id/forecastHourlyPeriodPlus24"
            style="@style/graph_period_radio_button"
            android:text="@string/forecast_hourly_period_plus24" />

    </RadioGroup>

    <!-- Daily-only: which slice of days the cards/strip charts below show. Hidden for Past/Hourly. -->
    <RadioGroup
        android:id="@+id/forecastDailyPeriodGroup"
        style="@style/graph_period_radio_group">

        <RadioButton
            android:id="@+id/forecastDailyPeriodNow"
            style="@style/graph_period_radio_button"
            android:layout_marginEnd="20dp"
            android:text="@string/forecast_daily_period_now" />

        <RadioButton
            android:id="@+id/forecastDailyPeriodPlus3Day"
            style="@style/graph_period_radio_button"
            android:layout_marginEnd="20dp"
            android:text="@string/forecast_daily_period_plus3day" />

        <RadioButton
            android:id="@+id/forecastDailyPeriodAll"
            style="@style/graph_period_radio_button"
            android:checked="true"
            android:text="@string/forecast_daily_period_all" />

    </RadioGroup>

    <!-- Past-only: how many trailing days of recorded history the cards/strip charts below show.
         Hidden for Hourly/Daily. -->
    <RadioGroup
        android:id="@+id/forecastPastPeriodGroup"
        style="@style/graph_period_radio_group">

        <RadioButton
            android:id="@+id/forecastPastPeriod3Day"
            style="@style/graph_period_radio_button"
            android:layout_marginEnd="20dp"
            android:text="@string/forecast_past_period_3day" />

        <RadioButton
            android:id="@+id/forecastPastPeriod7Day"
            style="@style/graph_period_radio_button"
            android:layout_marginEnd="20dp"
            android:checked="true"
            android:text="@string/forecast_past_period_7day" />

        <RadioButton
            android:id="@+id/forecastPastPeriod30Day"
            style="@style/graph_period_radio_button"
            android:layout_marginEnd="20dp"
            android:text="@string/forecast_past_period_30day" />

        <RadioButton
            android:id="@+id/forecastPastPeriodAll"
            style="@style/graph_period_radio_button"
            android:text="@string/forecast_past_period_all" />

    </RadioGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/forecastCardsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="10dp" />

        <FrameLayout
            android:id="@+id/forecastGraphsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
