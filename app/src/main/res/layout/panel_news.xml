<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/newsTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel_bottom"
        app:tabIndicatorColor="@color/accent_cool"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabTextColor="@color/text_secondary" />

    <FrameLayout
        android:id="@+id/newsListContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/newsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/newsEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Shows the US Drought Monitor NH map when the "Drought" sub-tab is selected -
         visibility toggled with newsRecyclerView above, never both visible at once. -->
    <FrameLayout
        android:id="@+id/droughtMonitorContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <WebView
            android:id="@+id/droughtMonitorWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/droughtErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Shows the TradingView Market Overview widget when the "Stocks" sub-tab is selected -
         visibility toggled alongside the other two views above, never more than one visible. -->
    <FrameLayout
        android:id="@+id/stocksContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <WebView
            android:id="@+id/stocksWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/stocksErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
