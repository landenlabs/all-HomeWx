<?xml version="1.0" encoding="utf-8"?>
<!-- Shared across all activity_main layout variants via <include> - selects which panel
     shows in infoPanelContainer. Tab tint (selected vs unselected) is set from MainActivity. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@color/bg_panel_bottom"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/newsTabButton"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tab_news_title"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_news"
        app:tint="@color/accent_cool" />

    <ImageButton
        android:id="@+id/forecastTabButton"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tab_forecast_title"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_forecast"
        app:tint="@color/text_secondary" />

    <ImageButton
        android:id="@+id/sensorGraphsTabButton"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tab_sensor_graphs_title"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_thermometer"
        app:tint="@color/text_secondary" />

</LinearLayout>
