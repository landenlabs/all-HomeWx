<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical">

    <!-- TOP HALF: current weather + upcoming significant changes + indoor sensors -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:background="@color/bg_panel_top"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- status / clock row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                tools:text="Friday, July 24" />

            <TextView
                android:id="@+id/modeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_warm"
                android:textSize="14sp"
                android:text="☀ Active" />

            <TextView
                android:id="@+id/clockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="7:42 PM" />
        </LinearLayout>

        <TextView
            android:id="@+id/weatherDateTimeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="24sp"
            tools:text="16 Aug, Sun 10:54 PM" />

        <LinearLayout
            android:id="@+id/weatherRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.4"
            android:orientation="horizontal">

            <!-- icon + big temperature, top-aligned -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="top|center_horizontal">

                <ImageView
                    android:id="@+id/weatherIcon"
                    android:layout_width="144dp"
                    android:layout_height="144dp"
                    android:contentDescription="@null"
                    android:src="@drawable/wx_sun_44d" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/currentTempText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="44sp"
                        android:text="@string/weather_placeholder" />

                    <TextView
                        android:id="@+id/tempTrendText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="33sp"
                        tools:text="+2°F" />
                </LinearLayout>
            </LinearLayout>

            <!-- condition/humidity/wind/precip/pressure table: label1,value1,label2,value2 -->
            <LinearLayout
                android:id="@+id/weatherDetailsTable"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:text="@string/weather_label_condition"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/conditionValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:layout_marginStart="8dp"
                        android:text="@string/weather_label_humidity"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/humidityValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:text="@string/weather_label_temp_high"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/tempHighValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:layout_marginStart="8dp"
                        android:text="@string/weather_label_temp_low"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/tempLowValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:text="@string/weather_label_wind_high"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/windHighValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:layout_marginStart="8dp"
                        android:text="@string/weather_label_wind_low"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/windLowValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:text="@string/weather_label_wind_speed"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/windSpeedValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:layout_marginStart="8dp"
                        android:text="@string/weather_label_wind_direction"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/windDirectionValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:text="@string/weather_label_precipitation"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/precipitationValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:layout_marginStart="8dp"
                        android:text="@string/weather_label_pressure"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/pressureValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:text="@string/weather_label_ly_max"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/lyMaxValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:layout_marginStart="8dp"
                        android:text="@string/weather_label_ly_min"
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp" />
                    <TextView
                        android:id="@+id/lyMinValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <!-- indoor govee sensors -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="INDOOR SENSORS"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sensorErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#E36464"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Sensor error: timeout" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sensorRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1.4"
            android:clipToPadding="false"
            android:overScrollMode="never" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/divider" />

    <!-- BOTTOM HALF: reserved for future info (news, etc.) / sensor strip chart -->
    <FrameLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:background="@color/bg_panel_bottom">

        <TextView
            android:id="@+id/futureInfoPlaceholderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/future_info_placeholder"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/stripChartPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/stripChartTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Sun room - temperature" />

            <com.dlang.homewx.ui.StripChartView
                android:id="@+id/stripChartView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
