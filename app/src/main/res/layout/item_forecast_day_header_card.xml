<?xml version="1.0" encoding="utf-8"?>
<!-- Divider card inserted before each day's run of hourly cards in the hourly forecast grid. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_forecast_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/dayHeaderDayOfWeekText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/accent_cool"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Monday" />

    <TextView
        android:id="@+id/dayHeaderDateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="Aug 20" />

</LinearLayout>
