<?xml version="1.0" encoding="utf-8"?>
<!-- Same as bg_forecast_card.xml, but tinted with the app's other near-black panel shade -
     used for every hourly card belonging to an "odd" day, so the day-to-day transition in the
     hourly card grid reads clearly while scrolling. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_panel_bottom" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="@color/divider" />
</shape>
