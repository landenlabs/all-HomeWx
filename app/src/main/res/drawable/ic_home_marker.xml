<?xml version="1.0" encoding="utf-8"?>
<!-- Home location pin on the radar map. White fill with a dark outline so it stays readable on
     the light and dark base maps and over green/yellow/red radar echoes. Anchored at the bottom
     center (the doorstep) on the home point. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round"
        android:pathData="M12,3 L2,12 H5 V21 H10 V15 H14 V21 H19 V12 H22 Z" />
</vector>
